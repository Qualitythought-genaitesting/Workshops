# Copy to .env and edit. run_all.bat / run_all.sh load this file.

# LLM provider: mock (offline, default) | openai | ollama
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
TEMPERATURE=0.3

# Classroom build with planted defects (true) or fixed build (false)
DEFECTS_ENABLED=true

# Agent limits
MAX_ITERATIONS=10
SESSION_SPEND_LIMIT=50000

# Test harness
RUNS=5
PORT=8000
# Pin "today" so date parsing in tests is stable (leave blank to use the real date)
# TRIPMATE_TODAY=2026-09-04

# Optional Langfuse export (pip install langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
