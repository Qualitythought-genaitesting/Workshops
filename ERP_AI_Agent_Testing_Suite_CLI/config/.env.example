# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to git.

# Required for LLM mode
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Optional – change if you use Azure, Groq, Together, Fireworks, local vLLM, etc.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (examples: gpt-4o-mini, gpt-4o, claude-3-5-sonnet, llama-3.1-70b, etc.)
OPENAI_MODEL=gpt-4o-mini

# Agent mode: "mock" (deterministic, no key needed) or "llm" (real LLM)
AGENT_MODE=mock
